# MemoryOS Environment Variables

# OpenAI API Key (required for OpenAI LLM and embeddings)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Gemini API Key (optional, for Gemini LLM)
GEMINI_API_KEY=your-gemini-api-key-here

# Claude API Key (optional, for Claude LLM)
CLAUDE_API_KEY=your-claude-api-key-here

# Redis URL (optional, defaults to redis://localhost:6379)
REDIS_URL=redis://redis:6379

# Qdrant URL (optional, defaults to http://localhost:6333)
QDRANT_URL=http://qdrant:6333

# Server Configuration (optional)
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
LOG_LEVEL=info
